e\u0432\u043a\u0438 \u0438\u043c\u043f\u043e\u0440\u0442\u0430."],"Stop Import":["\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0438\u043c\u043f\u043e\u0440\u0442"],"Select a default date range. When no range is selected, reports will be viewed by the default date range.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0430\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e. \u0415\u0441\u043b\u0438 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d, \u043e\u0442\u0447\u0435\u0442\u044b \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u0434\u0430\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."],"Actionable statuses:":["\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u044b:"],"Custom Statuses":["\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u044b"],"Exclude the %s status from reports":["\u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 %s \u0438\u0437 \u043e\u0442\u0447\u0435\u0442\u043e\u0432"],"Orders with these statuses require action on behalf of the store admin. These orders will show up in the Home Screen - Orders task.":["\u0417\u0430\u043a\u0430\u0437\u044b \u0441 \u044d\u0442\u0438\u043c\u0438 \u0441\u0442\u0430\u0442\u0443\u0441\u0430\u043c\u0438 \u0442\u0440\u0435\u0431\u0443\u044e\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043e\u0442 \u0438\u043c\u0435\u043d\u0438 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430. \u042d\u0442\u0438 \u0437\u0430\u043a\u0430\u0437\u044b \u0431\u0443\u0434\u0443\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u0432 \u043c\u0435\u043d\u044e \u00ab\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d\u00bb \u2014 \u00ab\u0417\u0430\u043a\u0430\u0437\u044b\u00bb."],"Orders with these statuses are excluded from the totals in your reports. The {{strong}}Refunded{{\/strong}} status can not be excluded.":["\u0417\u0430\u043a\u0430\u0437\u044b \u0441 \u044d\u0442\u0438\u043c\u0438 \u0441\u0442\u0430\u0442\u0443\u0441\u0430\u043c\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u0438\u0437 \u0438\u0442\u043e\u0433\u043e\u0432 \u0432 \u0432\u0430\u0448\u0438\u0445 \u043e\u0442\u0447\u0451\u0442\u0430\u0445. \u0421\u0442\u0430\u0442\u0443\u0441 {{strong}}\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u044b{{\/strong}} \u043d\u0435\u043b\u044c\u0437\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c."],"There was a problem rebuilding your report data.":["\u041f\u0440\u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u043e\u0442\u0447\u0451\u0442\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430."],"Default date range:":["\u0414\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0430\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e:"],"Excluded statuses:":["\u0418\u0441\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u044b:"],"MM\/DD\/YYYY":["MM\/DD\/YYYY"],"Status:":["\u0421\u0442\u0430\u0442\u0443\u0441:"],"Cancel":["\u041e\u0442\u043c\u0435\u043d\u0430"]}},"comment":{"reference":"assets\/client\/admin\/chunks\/analytics-settings.js"}}